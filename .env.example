# ─── Frontend ────────────────────────────────────────────────────────────────
# URL of the Qrypto backend API. If not set, the app runs in client-only demo mode.
VITE_API_URL=http://localhost:3001

# ─── Backend ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qrypto

# Redis connection string (for BullMQ job queue)
REDIS_URL=redis://localhost:6379

# JWT signing secret — use a strong random string in production
JWT_SECRET=change-me-to-a-strong-random-secret-at-least-32-chars

# Port the Express server listens on
PORT=3001

# Node environment: development | production
NODE_ENV=development

# Frontend URL for CORS (should match where Vite dev server runs)
FRONTEND_URL=http://localhost:5173

# ─── AI Layer (Optional — existing Gemini integration) ───────────────────────
# These keys are used by the frontend AI consultant (not the backend engine).
# The engine detection is purely deterministic and does NOT use AI.
# VITE_GEMINI_API_KEY=your-gemini-key-here
# VITE_OPENROUTER_API_KEY=your-openrouter-key-here
