# ============================================================
# Qrypto — Environment Configuration
# Copy this file to .env and fill in the values.
# ============================================================

# ─── Frontend ────────────────────────────────────────────────
# URL of the Qrypto backend API.
# If not set, the frontend runs in client-only demo mode.
VITE_API_URL=http://localhost:3001

# ─── Backend ─────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://qrypto:changeme@localhost:5432/qrypto

# Redis connection string (for BullMQ job queue)
REDIS_URL=redis://localhost:6379

# JWT signing secret — REQUIRED, at least 32 characters
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Port the Express server listens on
PORT=3001

# Node environment: development | production
NODE_ENV=development

# Frontend URL for CORS (should match where Vite dev server runs)
FRONTEND_URL=http://localhost:5173

# Number of reverse proxies in front of the app (0 if directly exposed)
TRUST_PROXY_HOPS=0

# ─── Auth Configuration ──────────────────────────────────────
# Self-service registration (default: enabled in dev, disabled in production)
ALLOW_PUBLIC_REGISTRATION=true

# Email for first admin bootstrap (requires zero existing admins)
BOOTSTRAP_ADMIN_EMAIL=

# ─── Docker Compose Variables ────────────────────────────────
# PostgreSQL password (must match DATABASE_URL)
POSTGRES_PASSWORD=changeme

# PostgreSQL port (host-side)
POSTGRES_PORT=5432

# Redis port (host-side)
REDIS_PORT=6379
